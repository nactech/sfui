{
  "name": "@nactech/sfui",
  "version": "0.1.0",
  "description": "SF UI — Black Glass React component kit for sf.fm mini-apps (web)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rollup -c",
    "rollup": "tsc -p tsconfig.build.json && rollup -c",
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "make-release": "npm run rollup && version=$(node -p \"require('./package.json').version\") && git add . && git commit --allow-empty --no-verify -am \"Release v$version\" && git push origin main && (npm publish || true) && (git tag -d v$version || true) && git tag v$version && git push origin v$version"
  },
  "author": "Mark Fomin",
  "license": "SEE LICENSE IN LICENSE.md",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "main": "dist/cjs/index.cjs",
  "module": "dist/esm/index.js",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./styles.css": "./dist/esm/module.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nactech/sfui.git"
  },
  "dependencies": {
    "lucide-react": "^1.79.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@rollup/plugin-alias": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.8",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.108.2",
    "storybook": "^10.6.8",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
